m-chrome-plugin/README.md\n@@ -18,11 +18,10 @@ core Linux port does not regularly test. Enable it by adding the feature id to\n When enabled, the feature:\n \n - adds Thorium to the bundled native-messaging manifest installer\n-- registers Thorium in the staged Chrome plugin's diagnostic and extension\n-  inventories\n-  (`scripts/extension-ids.json`), which is where upstream reads install\n-  commands, process names, profile directories, and native-messaging manifest\n-  locations from\n+- registers Thorium in the staged Chrome plugin's diagnostic inventory\n+  (`scripts/extension-ids.json`) for install commands, process names, profile\n+  directories, and native-messaging manifest locations; the extension inventory\n+  keeps upstream's supported browser families\n - registers Thorium in the Electron-side shared Chromium registry\n - refreshes Thorium's native-host manifest before launch and after first-run\n   plugin cache creation\ndiff --git a/linux-features/thorium-chrome-plugin/patch-chrome-plugin.js b/linux-features/thorium-chrome-plugin/patch-chrome-plugin.js\nindex 4b42950..6e31a20 100755\n--- a/linux-features/thorium-chrome-plugin/patch-chrome-plugin.js\n+++ b/linux-features/thorium-chrome-plugin/patch-chrome-plugin.js\n@@ -111,23 +111,24 @@ function registerThorium(pluginDir) {\n \n   const { source, parsed } = registry;\n   const diagnosticsEntry = thoriumEntryFor(parsed);\n-  const extensionEntry = parsed.browserExtensions.find(\n-    (browser) => browser?.browserFamily === \"chrome\",\n-  );\n-  if (diagnosticsEntry == null || extensionEntry == null) {\n+  if (diagnosticsEntry == null) {\n     warn(\n-      \"extension-ids.json missing a Chrome registry entry Thorium inherits from; leaving Thorium unregistered\",\n+      \"extension-ids.json missing a Chrome diagnostics entry Thorium inherits from; leaving Thorium unregistered\",\n     );\n     return false;\n   }\n \n+  // Diagnostics accepts Chromium variants; extension installation uses upstream's fixed schema.\n   let changed = false;\n   if (!parsed.browserDiagnostics.some((browser) => browser?.browserFamily === THORIUM_BROWSER_FAMILY)) {\n     parsed.browserDiagnostics.push(diagnosticsEntry);\n     changed = true;\n   }\n-  if (!parsed.browserExtensions.some((browser) => browser?.browserFamily === THORIUM_BROWSER_FAMILY)) {\n-    parsed.browserExtensions.push({ ...extensionEntry, browserFamily: THORIUM_BROWSER_FAMILY });\n+  const extensions = parsed.browserExtensions.filter(\n+    (browser) => browser?.browserFamily !== THORIUM_BROWSER_FAMILY,\n+  );\n+  if (extensions.length !== parsed.browserExtensions.length) {\n+    parsed.browserExtensions = extensions;\n     changed = true;\n   }\n   if (!changed) {\ndiff --git a/linux-features/thorium-chrome-plugin/test.js b/linux-features/thorium-chrome-plugin/test.js\nindex 2dd9e19..76edb03 100644\n--- a/linux-features/thorium-chrome-plugin/test.js\n+++ b/linux-features/thorium-chrome-plugin/test.js\n@@ -163,22 +163,10 @@ test(\"Thorium stage hook registers discovery and native-host installation\", () =\n     writeFakeChromePlugin(chromePlugin);\n     const registryPath = path.join(chromePlugin, \"scripts\", \"extension-ids.json\");\n     const existingRegistry = JSON.parse(fs.readFileSync(registryPath, \"utf8\"));\n-    const chrome = existingRegistry.browserDiagnostics[0];\n-    existingRegistry.browserDiagnostics.push({\n-      ...chrome,\n-      browserFamily: \"thorium\",\n-      linux: {\n-        ...chrome.linux,\n-        commands: [\"thorium-browser-avx2\", \"thorium-browser\", \"thorium\"],\n-        nativeMessagingManifestDirectories: [\".config/thorium/NativeMessagingHosts\"],\n-        processNames: [\"thorium\", \"thorium-browser\", \"thorium-browser-avx2\"],\n-        userDataDirectorySegments: [\".config\", \"thorium\"],\n-      },\n-    });\n-    fs.writeFileSync(registryPath, `${JSON.stringify(existingRegistry, null, 2)}\\n`);\n+    const originalExtensions = structuredClone(existingRegistry.brow