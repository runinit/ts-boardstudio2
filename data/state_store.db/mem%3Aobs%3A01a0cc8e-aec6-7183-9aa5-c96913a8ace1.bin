hrome-plugin/patch-chrome-plugin.js`; no tests found within 3 caller hops\n- `THORIUM_BROWSER_ENTRY` (.baseline-build-chOOpNFu/linux-features/thorium-chrome-plugin/patch-chrome-plugin.js:14) — 1 caller in `.baseline-build-chOOpNFu/linux-features/thorium-chrome-plugin/patch-chrome-plugin.js`; no tests found within 3 caller hops\n- `THORIUM_BROWSER_FAMILY` (linux-features/thorium-chrome-plugin/patch-chrome-plugin.js:7) — 2 callers in `linux-features/thorium-chrome-plugin/patch-chrome-plugin.js`; no tests found within 3 caller hops\n\n**Source Code**\n\n> The code below is the **verbatim, current on-disk source** of these files — re-read from disk on this call and line-numbered, byte-for-byte identical to what the Read tool returns. It is NOT a summary, outline, or stale cache. Treat each block as a Read you have already performed: do not Read a file shown here.\n\n**`linux-features/thorium-chrome-plugin/patch-chrome-plugin.js`** — registerThorium(function), THORIUM_BROWSER_ENTRY(constant), THORIUM_BROWSER_FAMILY(constant), readRegistry(function), thoriumEntryFor(function), detectIndent(function), +8 more\n\n```javascript\n1\t#!/usr/bin/env node\n2\t\"use strict\";\n3\t\n4\tconst fs = require(\"node:fs\");\n5\tconst path = require(\"node:path\");\n6\t\n7\tconst THORIUM_BROWSER_FAMILY = \"thorium\";\n8\tconst THORIUM_MANIFEST_DIR = \".config/thorium/NativeMessagingHosts\";\n9\tconst INSTALL_MANIFEST_ANCHOR = \".config/google-chrome-for-testing/NativeMessagingHosts\";\n10\t\n11\t// 26.803.41515 replaced the per-script Chrome-only Linux constants with a\n12\t// browser registry in extension-ids.json. Adding Thorium there covers manifest\n13\t// locations, the browser inventory, running-process detection, profile\n14\t// resolution, and window command selection in one entry, which is what the\n15\t// seven source patches this replaces did by hand.\n16\tconst THORIUM_BROWSER_ENTRY = {\n17\t  browserFamily: THORIUM_BROWSER_FAMILY,\n18\t  displayName: \"Thorium\",\n19\t  shortDisplayName: \"Thorium\",\n20\t  extensionManagementUrl: \"thorium://extensions\",\n21\t  linux: {\n22\t    commands: [\"thorium-browser-avx2\", \"thorium-browser\", \"thorium\"],\n23\t    configHomeEnvironmentVariables: [\"XDG_CONFIG_HOME\"],\n24\t    nativeMessagingManifestDirectories: [\".config/thorium/NativeMessagingHosts\"],\n25\t    processNames: [\"thorium\", \"thorium-browser\", \"thorium-browser-avx2\"],\n26\t    userDataDirectorySegments: [\".config\", \"thorium\"],\n27\t  },\n28\t  macos: {\n29\t    applicationNames: [\"Thorium.app\"],\n30\t    bundleId: \"org.chromium.Thorium\",\n31\t    nativeMessagingManifestDirectories: [\n32\t      \"Library/Application Support/Thorium/NativeMessagingHosts\",\n33\t    ],\n34\t    processNames: [\"Thorium\", \"Thorium Helper\"],\n35\t    userDataDirectorySegments: [\"Library\", \"Application Support\", \"Thorium\"],\n36\t  },\n37\t  windows: {\n38\t    commandNames: [\"thorium.exe\", \"thorium\"],\n39\t    installPathSegments: [\"Thorium\", \"Application\", \"thorium.exe\"],\n40\t    processNames: [\"thorium.exe\"],\n41\t    userDataDirectorySegments: [\"Thorium\", \"User Data\"],\n42\t  },\n43\t};\n44\t\n45\tfunction warn(message) {\n46\t  process.stderr.write(`WARN: ${message}\\n`);\n47\t}\n48\t\n49\tfunction detectIndent(source) {\n50\t  const match = source.match(/\\n([ \\t]+)\"/u);\n51\t  return match == null ? 2 : match[1].length;\n52\t}\n53\t\n54\tfunction readRegistry(registryPath) {\n55\t  let source;\n56\t  try {\n57\t    source = fs.readFileSync(registryPath, \"utf8\");\n58\t  } catch (error) {\n59\t    warn(\n60\t      `Could not read ${path.basename(registryPath)}: ${error.message}; leaving Thorium unregistered`,\n61\t    );\n62\t    return null;\n63\t  }\n64\t\n65\t  let parsed;\n66\t  try {\n67\t    parsed = JSON.parse(source);\n68\t  } catch (error) {\n69\t    warn(\n70\t      `Could not parse ${path.basename(registryPath)}: ${error.message}; leaving Thorium unregistered`,\n71\t    );\n72\t    return null;\n73\t  }\n74\t\n75\t  if (\n76\t    !Array.isArray(parsed?.browserDiagnostics) ||\n77\t    !Array.isArray(parsed?.browserExtensions)\n78\t  ) {\n79\t    warn(\n80\t      `${path.basename(registryPath)} missing browser registries; leaving Thorium unregistered`,\n81\t    );\n82\t    return null;\n83\t  }\n84\t\n85\t  return { source, parsed };\n86\t}\n87\t\n88\tfunction thoriumEntryFor(registry) {\n89\t  const donor = registry.browserDiagnostics.find(\n90\t    (browser) => browser?.browserFamily === \"chrome\",\n91\t  );\n92\t  if (donor == null) {\n93\t    return null;\n94\t  }\n95\t\n96\t  // Thorium is a Chromium fork and loads the same extension build, so it\n97\t  // inherits the Chrome extension identity rather than declaring its own.\n98\t  return {\n99\t    ...THORIUM_BROWSER_ENTRY,\n100\t    ...(donor.extensionIds == null ? {} : { extensionIds: [...donor.extensionIds] }),\n101\t    ...(donor.storeUrl == null ? {} : { storeUrl: donor.storeUrl }),\n102\t  };\n103\t}\n104\t\n105\tfunction registerThorium(pluginDir) {\n106\t  const registryPath = path.join(pluginDir, \"scripts\", \"extension-ids.json\");\n107\t  const registry = readRegistry(registryPath);\n108\t  if (registry == null) {\n109\t    return false;\n110\t  }\n111\t\n112\t  const { source, parsed } = registry;\n113\t  const diagnosticsEntry = thoriumEntryFor(parsed);\n114\t  const extensionEntry = parsed.browserExtensions.find(\n115\t    (browser) => browser?.browserFamily === \"chrome\",\n116\t  );\n117\t  if (diagnosticsEntry == null || extensionEntry == null) {\n118\t    warn(\n119\t      \"extension-ids.json missing a Chrome registry entry Thorium inherits from; leaving Thorium unregistered\",\n120\t    );\n121\t    return false;\n122\t  }\n123\t\n124\t  let changed = false;\n125\t  if (!parsed.browserDiagnostics.some((browser) => browser?.browserFamily === THORIUM_BROWSER_FAMILY)) {\n126\t    parsed.browserDiagnostics.push(diagnosticsEntry);\n127\t    changed = true;\n128\t  }\n129\t  if (!parsed.browserExtensions.some((browser) => browser?.browserFamily === THORIUM_BROWSER_FAMILY)) {\n130\t    parsed.browserExtensions.push({ ...extensionEntry, browserFamily: THORIUM_BROWSER_FAMILY });\n131\t    changed = true;\n132\t  }\n133\t  if (!changed) {\n134\t    console.log(\"extension-ids.json already patched: Thorium browser registry\");\n135\t    return true;\n136\t  }\n137\t\n138\t  const trailingNewline = source.endsWith(\"\\n\") ? \"\\n\" : \"\";\n139\t  fs.writeFileSync(\n140\t    registryPath,\n141\t    `${JSON.stringify(parsed, null, detectIndent(source))}${trailingNewline}`,\n142\t    \"utf8\",\n143\t  );\n144\t  console.log(\"Patched extension-ids.json: Thorium browser registry\");\n145\t  return true;\n146\t}\n147\t\n148\tfunction patchManifestInstaller(pluginDir) {\n149\t  const installerPath = path.join(pluginDir, \"scripts\", \"installManifest.mjs\");\n150\t  let source;\n151\t  try {\n152\t    source = fs.readFileSync(installerPath, \"utf8\");\n153\t  } catch (error) {\n154\t    warn(`Could not read ${path.basename(installerPath)}: ${error.message}; leaving Thorium manifest stale`);\n155\t    return false;\n156\t  }\n157\t\n158\t  const thoriumEntry = JSON.stringify(THORIUM_MANIFEST_DIR);\n159\t  if (source.includes(thoriumEntry)) {\n160\t    console.log(\"installManifest.mjs already patched: Thorium native host path\");\n161\t    return true;\n162\t  }\n163\t\n164\t  const anchor = JSON.stringify(INSTALL_MANIFEST_ANCHOR);\n165\t  const anchorIndex = source.indexOf(anchor);\n166\t  if (anchorIndex < 0 || anchorIndex !== source.lastIndexOf(anchor)) {\n167\t \n[...truncated]"},"sessionId":"01a0cc8e-aec6-7183-9aa5-c96913a8ace1","timestamp":"2026-09-23T04:38:37.260Z","toolInput":{"command":"codegraph explore 'linux-features/thorium-chrome-plugin/patch-chrome-plugin.js registerThorium and tests staging browserExtensions'"},"toolName":"Bash","toolOutput":"**Exploration: linux-features/thorium-chrome-plugin/patch-chrome-plugin.js registerThorium and