 build-ergogen\",\n    \"prestart\": \"pnpm run build-ergogen && pnpm run generate-previews\",\n    \"start\": \"vite\",\n    \"dev\": \"vite\",\n    \"prebuild\": \"pnpm run build-ergogen && pnpm run generate-previews\",\n    \"build\": \"vite build\",\n    \"test:unit\": \"vitest run\",\n    \"test:unit:watch\": \"vitest\",\n    \"test:e2e\": \"playwright test\",\n    \"test\": \"pnpm test:unit && pnpm test:e2e\",\n    \"format\": \"prettier --write \\\"*.{js,ts,json,md}\\\" \\\"{src,e2e,patch}/**/*.{ts,tsx,js,jsx,json,css,md}\\\"\",\n    \"lint:js\": \"eslint --fix \\\"{src,e2e,patch}/**/*.{ts,tsx,js,jsx}\\\"\",\n    \"lint:md\": \"markdownlint --fix \\\"**/*.md\\\"\",\n    \"lint\": \"pnpm lint:md && pnpm lint:js && pnpm knip\",\n    \"precommit\": \"pnpm format && pnpm lint && pnpm typecheck && pnpm test:footprints && pnpm test:unit\",\n    \"test:release\": \"node --test scripts/tests/*.test.cjs\",\n    \"build-kicanvas\": \"./patch/kicanvas/build.sh\",\n    \"typecheck\": \"tsc --noEmit\",\n    \"test:footprints\": \"pnpm --dir ../footprints test\"\n  },\n  \"browserslist\": {\n    \"production\": [\n      \">0.2%\",\n      \"not dead\",\n      \"not op_mini all\"\n    ],\n    \"development\": [\n      \"last 1 chrome version\",\n      \"last 1 firefox version\",\n      \"last 1 safari version\"\n    ]\n  },\n  \"devDependencies\": {\n    \"@eslint/js\": \"^9.36.0\",\n    \"@playwright/test\": \"^1.55.1\",\n    \"@testing-library/jest-dom\": \"^6.4.2\",\n    \"@testing-library/react\": \"^15.0.2\",\n    \"@testing-library/user-event\": \"^14.5.2\",\n    \"@types/file-saver\": \"^2.0.7\",\n    \"@types/js-yaml\": \"^4.0.9\",\n    \"@types/lodash-es\": \"^4.17.12\",\n    \"@types/lodash.debounce\": \"^4.0.9\",\n    \"@types/react\": \"^18.2.0\",\n    \"@types/react-dom\": \"^18.3.7\",\n    \"@types/styled-components\": \"^5.1.34\",\n    \"@types/three\": \"0.180.0\",\n    \"@typescript-eslint/eslint-plugin\": \"^8.45.0\",\n    \"@typescript-eslint/parser\": \"^