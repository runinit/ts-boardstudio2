sion, installedAt, enabledFeatures, features, sourceRevision}' /opt/codex-desktop/resources/codex-linux-build-info.json; jq '{name,path,type,allowed_origins}' /home/chris/.config/thorium/NativeMessagingHosts/com.openai.codexextension.json; readlink -f /home/chris/.config/thorium/NativeMessagingHosts/com.openai.codexextension.json; ls -l /opt/codex-desktop/resources/plugins/openai-bundled/plugins 2>/dev/null | head -20"},"toolName":"Bash","toolOutput":"{\n  \"version\": null,\n  \"upstreamVersion\": null,\n  \"installedAt\": null,\n  \"enabledFeatures\": null,\n  \"features\": null,\n  \"sourceRevision\": null\n}\n{\n  \"name\": \"com.openai.codexextension\",\n  \"path\": \"/home/chris/.codex/plugins/cache/openai-bundled/chrome/latest/extension-host/linux/x64/extension-host\",\n  \"type\": \"stdio\",\n  \"allowed_origins\": [\n    \"chrome-extension://hehggadaopoacecdllhhajmbjkdcmajg/\",\n    \"chrome-extension://odlomjlbamekndcpllcnffbgeohgkmjh/\"\n  ]\n}\n/home/chris/.config/thorium/NativeMessagingHosts/com.openai.codexextension.json\ntotal 0\ndrwxr-xr-x 1 nobody nobody  96 Aug 14 16:21 browser\ndrwxr-xr-x 1 nobody nobody 124 Aug 14 16:21 chrome\ndrwxr-xr-x 1 nobody nobody  74 Sep 22 21:35 chronicle-skysight\ndrwxr-xr-x 1 nobody nobody  78 Sep 22 21:35 codex-app-tools\ndrwxr-xr-x 1 nobody nobody  26 Sep 14 00:12 computer-use\ndrwxr-xr-x 1 nobody nobody  50 Aug 14 16:21 deep-research\ndrwxr-xr-x 1 nobody nobody 172 Sep 22 21:35 latex\ndrwxr-xr-x 1 nobody nobody  62 Sep 22 21:35 read-aloud\ndrwxr-xr-x 1 nobody nobody  74 Sep 22 21:35 record-and-replay\ndrwxr-xr-x 1 nobody nobody  64 Sep 22 21:35 unified-computer-use\ndrwxr-xr-x 1 nobody nobody  50 Aug 30 11:27 user-writing\ndrwxr-xr-x 1 nobody nobody  50 Aug 14 16:21 visualize\n"},"obs_mudlv9zi_ea33f342e5ae":{"hookType":"post_tool_use","id":"obs_mudlv9zi_ea33f342e5ae","origin":{"capturedAt":"2026-09-23T04:31:11.653Z","channel":"tool","detail":"Bash"},"raw":{"tool_input":{"command":"sed -n '1,260p' linux-features/thorium-chrome-plugin/sync-manifest.js; sed -n '1,160p' linux-features/thorium-chrome-plugin/sync-manifest.sh; sed -n '1,160p' linux-features/thorium-chrome-plugin/manifest-sync.test.js"},"tool_name":"Bash","tool_output":"#!/usr/bin/env node\n\"use strict\";\n\nconst fs = require(\"node:fs\");\nconst path = require(\"node:path\");\n\nconst ARCH_DIRS = new Map([\n  [\"x64\", \"x64\"],\n  [\"arm64\", \"arm64\"],\n]);\nconst HOST_DESCRIPTION = \"ChatGPT browser native messaging host\";\n\nfunction syncManifest(pluginRoot, manifestPath, arch = process.arch) {\n  const registryPath = path.join(pluginRoot, \"scripts\", \"extension-ids.json\");\n  const registry = JSON.parse(fs.readFileSync(registryPath, \"utf8\"));\n  const thorium = registry.browserDiagnostics?.find(\n    (browser) => browser?.browserFamily === \"thorium\",\n  );\n  const archDir = ARCH_DIRS.get(arch);\n  if (typeof registry.extensionHostName !== \"string\" || thorium == null || archDir == null) {\n    throw new Error(\"Thorium native-host metadata is incomplete\");\n  }\n\n  const hostPath = path.join(pluginRoot, \"extension-host\", \"linux\", archDir, \"extension-host\");\n  fs.accessSync(hostPath, fs.constants.X_OK);\n  const manifest = {\n    allowed_origins: thorium.extensionIds.map((id) => `chrome-extension://${id}/`),\n    description: HOST_DESCRIPTION,\n    name: registry.extensionHostName,\n    path: hostPath,\n    type: \"stdio\",\n  };\n  const manifestDir = path.dirname(manifestPath);\n  const tempPath = path.join(manifestDir, `.${path.basename(manifestPath)}.${process.pid}.tmp`);\n  fs.mkdirSync(manifestDir, { recursive: true });\n  try {\n    fs.writeFileSync(tempPath, `${JSON.stringify(manifest, null, 2)}\\n`, { mode: 0o600 });\n    fs.renameSync(tempPath, manifestPath);\n  } catch (error) {\n    fs.rmSync(tempPath, { force: true });\n    throw error;\n  }\n}\n\nif (require.main === module) {\n  syncManifest(process.argv[2], process.argv[3]);\n}\n\nmodule.exports = { syncManifest };\n#!/usr/bin/env bash\nset -euo pipefail\n\n# Launcher context comes from the environment; arguments may be deep links.\napp_dir=\"${CODEX_LINUX_APP_DIR:?launcher app directory is required}\"\nplugin_root=\"${CODEX_HOME:-$HOME/.codex}/plugins/cache/openai-bundled/chrome/latest\"\nconfig_home=\"${XDG_CONFIG_HOME:-$HOME/.config}\"\nhost_arch=\"$(uname -m)\"\ncase \"$host_arch\" in\n    x86_64) extension_arch=x64 ;;\n    aarch64|arm64) extension_arch=arm64 ;;\n    *) exit 0 ;;\nesac\n\nnode_path=\"$app_dir/resources/cua_node/bin/node\"\nsync_script=\"$app_dir/.codex-linux/features/thorium-chrome-plugin/sync-manifest.js\"\nregistry_path=\"$plugin_root/scripts/extension-ids.json\"\nhost_path=\"$plugin_root/extension-host/linux/$extension_arch/extension-host\"\nmanifest_path=\"$config_home/thorium/NativeMessagingHosts/com.openai.codexextension.json\"\nmax_attempts=1\nwait_seconds=0.25\nif [ \"${CODEX_LINUX_FEATURE_HOOK_PHASE:-}\" = cold-start ]; then\n    max_attempts=80\nfi\n\n# The plugin cache is materialized after launch on a fresh profile.\nattempt=1\nwhile [ \"$attempt\" -le \"$max_attempts\" ]; do\n    if [ -r \"$registry_path\" ] && [ -x \"$host_path\" ]; then\n        if ! \"$node_path\" \"$sync_script\" \"$plugin_root\" \"$manifest_path\"; then\n            printf 'warning: could not refresh the Thorium native-host manifest\\n' >&2\n        fi\n        exit 0\n    fi\n    attempt=$((attempt + 1))\n    [ \"$attempt\" -le \"$max_attempts\" ] && sleep \"$wait_seconds\"\ndone\n\n# The cache is created by Electron on first launch, so it cannot block startup.\nexit 0\n\"use strict\";\n\nconst assert = require(\"node:assert/strict\");\nconst { spawnSync } = require(\"node:child_process\");\nconst fs = require(\"node:fs\");\nconst os = require(\"node:os\");\nconst path = require(\"node:path\");\nconst test = require(\"node:test\");\nconst { stageEnabledLinuxFeatureInstall } = require(\"../../scripts/lib/linux-features.js\");\n\nconst HOST_NAME = \"com.openai.codexextension\";\nconst EXTENSION_IDS = [\n  \"hehggadaopoacecdllhhajmbjkdcmajg\",\n  \"odlomjlbamekndcpllcnffbgeohgkmjh\",\n];\n\ntest(\"Thorium prelaunch accepts a missing plugin cache\", (t) => {\n  // A fresh profile creates the cache only after Electron starts.\n  const root = fs.mkdtempSync(path.join(os.tmpdir(), \"codex-thorium-empty-cache-\"));\n  t.after(() => fs.rmSync(root, { recursive: true, force: true }));\n  const appDir = path.join(root, \"app\");\n  const codexHome = path.join(root, \"codex-home\");\n  const featuresRoot = path.join(root, \"features\");\n\n  fs.cpSync(__dirname, path.join(featuresRoot, \"thorium-chrome-plugin\"), { recursive: true });\n  fs.writeFileSync(path.join(featuresRoot, \"features.json\"), JSON.stringify({ enabled: [\"thorium-chrome-plugin\"] }));\n  stageEnabledLinuxFeatureInstall(appDir, { featuresRoot });\n\n  const hook = path.join(appDir, \".codex-linux\", \"prelaunch.d\", \"thorium-chrome-plugin-thorium-native-host.sh\");\n  const result = spawnSync(hook, [], {\n    encoding: \"utf8\",\n    env: { ...process.env, CODEX_LINUX_APP_DIR: appDir, CODEX_HOME: codexHome, HOME: root },\n  });\n\n  assert.equal(result.status, 0, result.stderr || \"Thorium hook rejected a missing cache\");\n});\n\nfunction checkManifest(t, originalArgs) {\n  // Given: a current plugin cache and a Thorium manifest targeting the legacy host.\n  const root = fs.mkdtempSync(path.join(os.tmpdir(), \"codex-thorium-manifest-\"));\n  t.after(() => fs.rmSync(root, { recursive: true, force: true }));\n  const appDir = path.join(root, \"app\");\n  const codexHome = path.join(root, \"codex-home\");\n  const configHome = path.join(root, \"config\");\n  const featuresRoot = path.join(root, \"features\");\n  const pluginRoot = path.join(codexHome, \"plugins\", \"cache\", \"openai-bundled\", \"chrome\", \"latest\");\n  const hostPath = path.join(pluginRoot, \"extension-host\", \"linux\", \"x64\", \"extension-host\");\n  const manifestPath = path.join(configHome, \"thorium\", \"NativeMessagingHosts\", `${HOST_NAME}.json`);\n  fs.cpSync(__dirname, path.join(featuresRoot, \"thorium-chrome-plugin\"), { recursive: true });\n  fs.writeFileSync(path.join(featuresRoot, \"features.json\"), JSON.stringify({ enabled: [\"thorium-chrome-plugin\"] }));\n  fs.mkdirSync(path.join(pluginRoot, \"scripts\"), { recursive: true });\n  fs.mkdirSync(path.dirname(hostPath), { recursive: true });\n  fs.mkdirSync(path.dirname(manifestPath), { recursive: true });\n  fs.writeFileSync(path.join(pluginRoot, \"scripts\", \"extension-ids.json\"), JSON.stringify({\n    extensionHostName: HOST_NAME,\n    browserDiagnostics: [{ browserFamily: \"thorium\", extensionIds: EXTENSION_IDS }],\n  }));\n  fs.writeFileSync(hostPath, \"host\");\n  fs.chmodSync(hostPath, 0o755);\n  fs.writeFileSync(manifestPath, JSON.stringify({ name: HOST_NAME, path: \"/legacy/native-host\" }));\n  fs.mkdirSync(path.join(appDir, \"resources\", \"cua_node\", \"bin\"), { recursive: true });\n  fs.symlinkSync(process.execPath, path.join(appDir, \"resources\", \"cua_node\", \"bin\", \"node\"));\n  stageEnabledLinuxFeatureInstall(appDir, { featuresRoot });\n\n  // When: the staged prelaunch hooks run.\n  const hooksDir = path.join(appDir, \".codex-linux\", \"prelaunch.d\");\n  for (const hook of fs.existsSync(hooksDir) ? fs.readdirSync(hooksDir).sort() : []) {\n    const result = spawnSync(path.join(hooksDir, hook), originalArgs, {\n      encoding: \"utf8\",\n      env: { ...process.env, CODEX_LINUX_APP_DIR: appDir, CODEX_HOME: codexHome, HOME: root, XDG_CONFIG_HOME: configHome },\n    });\n    assert.equal(result.status, 0, result.stderr);\n  }\n\n  // Then: Thorium targets the current host with both supported extension origins.\n  const manifest = JSON.parse(fs.readFileSync(manifestPath, \"utf8\"));\n  assert.equal(manifest.path, hostPath);\n  assert.deepEqual(manifest.allowed_origins, EXTENSION_IDS.map((id) => `chrome-extension://${id}/`));\n}\n\nfor (const args of [[], [\"codex://thread/123\", \"--new-window\"]]) {\n  test(`Thorium refreshes its manifest with desktop arguments ${JSON.stringify(args)}`, (t) => {\n    checkManifest(t, args);\n  });\n}\n"},"sessionId":"01a0cc87-495d-7e22-87ae-bd213dd99181","timestamp":"2026-09-23T04:31:11.653Z","toolInput":{"command":"sed -n '1,260p' linux-features/thorium-chrome-plugin/sync-manifest.js; sed -n '1,160p' linux-features/thorium-chrome-plugin/sync-manifest.sh; sed -n '1,160p' linux-features/thorium-chrome-plugin/manifest-sync.test.js"},"toolName":"Bash","toolOutput":"#!/usr/bin/env node\n\"use strict\";\n\nconst fs = require(\"node:fs\");\nconst path = require(\"node:path\");\n\nconst ARCH_DIRS = new Map([\n  [\"x64\", \"x64\"],\n  [\"arm64\", \"arm64\"],\n]);\nconst HOST_DESCRIPTION = \"ChatGPT browser native messaging host\";\n\nfunction syncManifest(pluginRoot, manifestPath, arch = process.arch) {\n  const registryPath = path.join(pluginRoot, \"scripts\", \"extension-ids.json\");\n  const registry = JSON.parse(fs.readFileSync(registryPath, \"utf8\"));\n  const thorium = registry.browserDiagnostics?.find(\n    (browser) => browser?.browserFamily === \"thorium\",\n  );\n  const archDir = ARCH_DIRS.get(arch);\n  if (typeof registry.extensionHostName !== \"string\" || thorium == null || archDir == null) {\n    throw new Error(\"Thorium native-host metadata is incomplete\");\n  }\n\n  const hostPath = path.join(pluginRoot, \"extension-host\", \"linux\", archDir, \"extension-host\");\n  fs.accessSync(hostPath, fs.constants.X_OK);\n  const manifest = {\n    allowed_origins: thorium.extensionIds.map((id) => `chrome-extension://${id}/`),\n    description: HOST_DESCRIPTION,\n    name: registry.extensionHostName,\n    path: hostPath,\n    type: \"stdio\",\n  };\n  const manifestDir = path.dirname(manifestPath);\n  const tempPath = path.join(manifestDir, `.${path.basename(manifestPath)}.${process.pid}.tmp`);\n  fs.mkdirSync(manifestDir, { recursive: true });\n  try {\n    fs.writeFileSync(tempPath, `${JSON.stringify(manifest, nul