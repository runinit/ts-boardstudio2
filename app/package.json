{
  "name": "@boardstudio/v2-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && node scripts/write-sw.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:dev": "playwright test --config playwright.dev.config.ts",
    "test:perf": "node scripts/run-performance.mjs",
    "test:e2e:pages": "playwright test --config playwright.pages.config.ts"
  },
  "dependencies": {
    "@boardstudio/v2-cad": "workspace:*",
    "@boardstudio/v2-contracts": "workspace:*",
    "@boardstudio/v2-ergogen": "workspace:*",
    "@boardstudio/v2-kicad": "workspace:*",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "three": "0.180.0"
  },
  "devDependencies": {
    "@playwright/test": "1.55.1",
    "@types/react": "18.3.28",
    "@types/react-dom": "18.3.7",
    "@types/three": "0.180.0",
    "@vitejs/plugin-react": "4.7.0",
    "fake-indexeddb": "6.2.4",
    "fflate": "0.8.2",
    "typescript": "5.9.3",
    "vite": "6.3.5",
    "vitest": "3.2.4"
  }
}
